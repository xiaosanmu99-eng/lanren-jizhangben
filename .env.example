# Copy to .env.local for a machine you control. Never commit .env.local.
# Production secrets belong in the host's secret store, not in git and not in URLs.

# Postgres connection. Cursor Apps injects DATABASE_URL when a database is provisioned.
DATABASE_URL=postgresql://ledger:change-me@127.0.0.1:5432/ledger

# One-time code typed into the setup form. At least 16 characters.
# This is not a login password and must not be placed in a link.
LEDGER_SETUP_TOKEN=replace-with-a-long-random-token

# Optional bearer token for a future assistant. Leave empty until that
# integration is actually approved. At least 16 characters when set.
LEDGER_INGEST_TOKEN=
